; ----------------------------------------------------------------------------
; platformio_release.ini.template
; ----------------------------------------------------------------------------
; Copied to platformio_release.ini by the release CI workflow
; (.github/workflows/release.yml -> build.yml with `release: true`)
;
; This file overrides `[platformio].default_envs` from platformio.ini via
; `extra_configs`. It MUST list every env that should be released — it fully
; replaces the parent value.
;
; dpx_tc002_frm ships ONE board (ulanzi_tc001 / ulanzi TC001 hardware) — this
; was inherited from upstream WLED's own release matrix (originally ~29 stock
; board environments: esp8266 variants, various esp32/esp32s3/esp32c3 boards,
; HUB75 panel boards) and never trimmed down after the fork. That meant every
; tagged release built 29 unrelated firmwares nobody uses (our real
; distribution is the GH Pages /flash/ page's ulanzi_tc001 build, not GH
; Releases assets), burning CI minutes and blowing well past GitHub's 10GB
; per-repo Actions cache limit (confirmed at 10.78GB/38 caches — each of
; those 29 envs caches its own toolchain separately).
;
; Do NOT commit a generated platformio_release.ini (it's in .gitignore).
; ----------------------------------------------------------------------------

[platformio]
default_envs = ulanzi_tc001
